# Cal2do Automated E2E Test Configuration
# Copy this file to .env.test.local or .env.test and fill in values if needed

# Target URL (Production or Local development server)
TEST_BASE_URL=https://caltodo-lbbz.vercel.app/
# TEST_BASE_URL=http://localhost:3000

# Custom Chrome/Chromium executable path (Leave empty for auto-detection)
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/google-chrome
CHROME_PATH=

# Chrome DevTools Remote Debugging Port
CHROME_DEBUG_PORT=9555

# Headless mode (true or false)
HEADLESS=true

# Test Account Credentials (Optional, secrets are never committed to git)
TEST_GOOGLE_EMAIL=
TEST_GOOGLE_PASSWORD=
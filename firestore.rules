rules_version = '2';

// 이 파일은 참고용입니다. Firebase는 저장소에 있는 규칙 파일을 자동으로 배포하지 않아요.
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 붙여넣고 "게시(Publish)"를 눌러야 적용됩니다.
//
// "닫았다 열면 데이터가 사라진다" / "저장이 계속 실패한다" 같은 증상은 대부분
// 이 규칙이 없거나 너무 제한적으로 설정되어 있어서(=쓰기가 실제로는 거부됐는데
// 화면에서는 알아채기 어려웠던 경우) 발생합니다. 아래 규칙은 로그인한 본인 소유의
// 문서만 읽고 쓸 수 있도록 허용합니다.

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    match /todos/{todoId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    match /notes/{noteId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
